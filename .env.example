# Local/dev (com `docker compose up -d` deste repo):
DATABASE_URL="postgresql://acompanhe:acompanhe@localhost:5432/acompanhe?schema=public"

# Produção: Postgres DEDICADO no VPS (não compartilhar credencial com o
# Painel de Missões — este banco guarda dados pessoais de clientes sob a
# LGPD). Use a connection string INTERNA do serviço, não a externa/pública.

# URL pública do app — usada para montar o link mágico enviado por e-mail
# (https://acompanhe.innovarecode.com.br em produção; http://localhost:3000
# em dev). Sem barra final.
APP_URL="http://localhost:3000"

# --- SMTP (e-mail transacional: link mágico de login + notificações) -----
# Sem SMTP configurado, ninguém consegue logar (não existe modo "finge que
# enviou" — mesma regra do Painel de Missões, ver lib/email.ts).
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
EMAIL_FROM="InnovareCode Acompanhe <acompanhe@innovarecode.com.br>"

# E-mail interno que recebe o aviso de "novo briefing recebido" a cada
# POST /api/v1/intakes bem-sucedido. Opcional — se vazio, só loga.
STAFF_NOTIFY_EMAIL=""

# Origens autorizadas a chamar POST /api/v1/intakes (CORS), separadas por
# vírgula — só o(s) domínio(s) do site público.
INTAKE_ALLOWED_ORIGINS="https://www.innovarecode.com.br,https://innovarecode.com.br"

# Origens extras autorizadas para Server Actions atrás de proxy reverso em
# HTTPS (ex.: EasyPanel). Vazio em dev local.
ALLOWED_ORIGINS=""

# Número de proxies reversos CONFIÁVEIS na frente do app (ver lib/request-ip.ts)
# — usado para extrair o IP real do cliente de dentro de `X-Forwarded-For` sem
# confiar no valor que o próprio requisitante pode forjar. Padrão "1" assume a
# topologia padrão deste projeto (client -> Traefik/EasyPanel -> container).
# AÇÃO DO VULCANO antes do deploy: confirmar no EasyPanel/Traefik se o proxy
# SUBSTITUI o header X-Forwarded-For recebido do cliente (mantém só o valor
# que ele próprio viu) ou se ACRESCENTA à lista existente. Nos dois casos
# "1" funciona — mas se houver MAIS de um proxy confiável encadeado antes do
# app (ex.: um LB extra na frente do Traefik), ajustar este número para o
# total de hops confiáveis, senão o rate-limit por IP volta a ser contornável.
TRUST_PROXY_HOPS="1"

# Desliga o `prisma migrate deploy` automático no boot do container (ver
# docker-entrypoint.sh). Padrão: true.
RUN_MIGRATIONS="true"
